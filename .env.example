# Copy to .env for local development overrides.

# VITE_API_BASE=/api routes through Vite's own dev-server proxy (see the
# /api entry in vite.config.ts, which forwards to http://localhost:3000)
# instead of hitting the real production API directly. Only read by
# `npm run dev` — production baking is separate (see BACKEND_API_HOSTNAME
# below).
VITE_API_BASE=/api

# Feeds `npm run gen:api` (openapi-ts.config.ts) — bare hostname only.
DOCS_HOSTNAME=docs.slovo-propovedi.ru

# Docker --build-arg only (Dockerfile), NOT read by `npm run dev`/`build`
# directly — not auto-loaded from this file. Sets the production
# VITE_API_BASE baked into the Vite build, and the nginx CSP connect-src.
# Bare hostname only. Local reference: `docker build --build-arg
# BACKEND_API_HOSTNAME=api.slovo-propovedi.ru .`
BACKEND_API_HOSTNAME=api.slovo-propovedi.ru
